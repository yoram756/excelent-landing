# Environment variables read by this repository. Copy to .env for local use; .env is gitignored.
# No secrets belong here. Monday, Gambot, Calendly and Meta credentials live in n8n credentials,
# and the staging htpasswd lives on the VPS in /docker/lp-secrets, never in the repo.
# Campaign and niche settings (Monday board, column ids, identity, messages) are not env vars:
# they live in src/config/campaigns/<id>.json so each niche is one config file.

# Which src/config/campaigns/<id>.json build-workflows.js builds (default: refi)
CAMPAIGN=refi

# Path to an nginx binary for npm run test:deploy (default: nginx on PATH)
NGINX_BINARY=

# Path to a Chromium or headless shell for npm run test:site (default: Playwright's bundled browser)
PW_CHROMIUM=
