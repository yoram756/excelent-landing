# Environment variables read by this repository. Copy to .env for local use; .env is gitignored.
# No secrets belong here. Monday, Cosend, Calendly and Meta Lead Ads credentials live in n8n credentials,
# and the staging htpasswd lives on the VPS in /docker/lp-secrets, never in the repo.
# Campaign and niche settings (Monday board, column ids, identity, messages) are not env vars:
# they live in src/config/campaigns/<id>.json so each niche is one config file.

# Which src/config/campaigns/<id>.json build-workflows.js builds (default: refi)
CAMPAIGN=refi

# Path to an nginx binary for npm run test:deploy (default: nginx on PATH)
NGINX_BINARY=

# Path to a Chromium or headless shell for npm run test:site (default: Playwright's bundled browser)
PW_CHROMIUM=

# Lock service (src/services/lifecycle/lock-server.js). Secret: set only on the server, never commit a value.
LOCK_SERVER_TOKEN=
# Absolute path ending in .sqlite
LOCK_DB_PATH=
LOCK_SERVER_HOST=127.0.0.1
LOCK_SERVER_PORT=8787

# Meta Lead Ads adapter (src/webhooks/intake/meta-adapter.js). Secrets: set only on the server, never commit a value.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=

# WhatsApp Cloud API sends (src/services/funnel/build-workflows.js): required for pilot and live builds.
# Not secrets: the access token lives only in the n8n credential (header Authorization: Bearer <token>).
META_WA_PHONE_NUMBER_ID=
META_WA_CREDENTIAL_ID=

# Business operations sandbox. Bind is always 127.0.0.1. No outbound dispatch.
OPS_DB_PATH=
OPS_PORT=8791
OPS_INGEST_TOKEN=
OPS_REVIEW_TOKEN=
OPS_READ_TOKEN=
