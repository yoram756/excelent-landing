{
  "name": "excelent-lock",
  "services": {
    "lock-server": {
      "build": {
        "context": "../..",
        "dockerfile": "deploy/lock/Dockerfile"
      },
      "restart": "unless-stopped",
      "init": true,
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "environment": {
        "LOCK_SERVER_HOST": "0.0.0.0",
        "LOCK_SERVER_PORT": "8787",
        "LOCK_DB_PATH": "/data/lifecycle.sqlite"
      },
      "volumes": [
        "lock_data:/data"
      ],
      "secrets": [
        "lock_token"
      ],
      "networks": {
        "n8n": {
          "aliases": [
            "excelent-lock-server"
          ]
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:8787/health').then(async r=>{if(!r.ok||(await r.json()).ok!==true)process.exit(1)}).catch(()=>process.exit(1))"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    }
  },
  "networks": {
    "n8n": {
      "external": true,
      "name": "n8n-qhxa_default"
    }
  },
  "volumes": {
    "lock_data": {}
  },
  "secrets": {
    "lock_token": {
      "file": "/docker/lp-lock-secrets/token"
    }
  }
}
