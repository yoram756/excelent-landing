# Production environment for the lead funnel. Generated by src/deploy/package.js: edit the list there, not here.
# Copy to .env.production on the server only (gitignored). Never commit a value for a secret.

# Lock service (src/services/lifecycle/lock-server.js), runs next to n8n
# Address to listen on. Use the internal Docker network address n8n reaches, never a public interface
LOCK_SERVER_HOST=
LOCK_SERVER_PORT=8787
# Secret, at least 32 characters. The same value goes into the n8n Header Auth credential "Lock server" as "Bearer <token>"
LOCK_SERVER_TOKEN=
# Absolute path ending in .sqlite, on a persistent volume
LOCK_DB_PATH=

# Intake patch (src/webhooks/intake/patch-export.js), used once when wiring the intake workflow
# How n8n reaches the lock service, for example http://lock-server:8787
LOCK_SERVER_URL=
# Id of the n8n Header Auth credential "Lock server"
LOCK_CREDENTIAL_ID=
# Id of the imported instant reply workflow in n8n
INSTANT_REPLY_WORKFLOW_ID=
# Campaign file for build-workflows.js and patch-export.js
CAMPAIGN=refi

# Cosend (current provider; outbound disabled pending approval)
# Secret. Install only in a scoped n8n Credential or secret store; never use the read-only numbers key for sending
COSEND_API_KEY=
# Id of an existing approved Cosend n8n credential; id is not a secret
COSEND_CREDENTIAL_ID=

# Legacy provider compatibility (not used for new WhatsApp delivery)
# Deprecated secret placeholder retained for dependency review; do not reconnect or use for the Cosend migration
GAMBOT_API_KEY=

# Meta Lead Ads (src/webhooks/intake/meta-adapter.js)
# Secret. Must equal the verify token entered in the Meta app webhook settings
META_VERIFY_TOKEN=
# Secret. Meta app secret, used to check X-Hub-Signature-256
META_APP_SECRET=
# Secret. Page access token with leads_retrieval
META_ACCESS_TOKEN=

# Legacy Meta WhatsApp compatibility (ignored by new builds; never bypass Cosend)
# Deprecated delivery setting. Canonical Cosend binding is in src/services/wa-assistant/config/provider.json
META_WA_PHONE_NUMBER_ID=
# Deprecated delivery credential setting; does not enable pilot or live generation
META_WA_CREDENTIAL_ID=

# Business operations sandbox (loopback only; no outbound dispatch)
# Absolute .sqlite path on a protected persistent volume
OPS_DB_PATH=
# Loopback port for the local operations service
OPS_PORT=8791
# Secret, distinct role token of at least 32 characters
OPS_INGEST_TOKEN=
# Secret, distinct reviewer role token; never give to source/LLM workers
OPS_REVIEW_TOKEN=
# Secret, distinct internal reader role token
OPS_READ_TOKEN=
