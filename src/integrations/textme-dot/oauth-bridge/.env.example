# Example only. Public base must be a dedicated /textme-dot path behind TLS.
TEXTME_AUTH_PUBLIC_BASE=https://n8n-qhxa.srv1604140.hstgr.cloud/textme-dot
# Supply the verified private gateway URL only in the private deployment config.
TEXTME_READ_MCP_URL=
TEXTME_CALLER_KEY_FILE=/run/secrets/textme_caller_key
TEXTME_ACCOUNT_USERNAME=office@kho.org.il
TEXTME_OAUTH_CLIENT_ID=excelent-textme-dot
# Read from the host's User-Defined OAuth Client form on 2026-10-29.
# Verify it again during actual registration; never use a fixture callback.
TEXTME_OAUTH_CALLBACKS=["https://chatgpt.com/connector_platform_oauth_redirect"]
TEXTME_AUTH_STATE_DIR=/var/lib/textme-auth
TEXTME_AUTH_BIND=127.0.0.1
TEXTME_AUTH_PORT=8790
